WEBUI_ADMIN_EMAIL=testemail@example.com
# Set a unique administrator password in your private .env or deployment secrets.
WEBUI_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OPENAI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
OPENAI_API_KEY="YOUR_GEMINI_API_KEY"
SMTP_EMAIL=your-relay@gmail.com
SMTP_PASSWORD="your-gmail-app-password"

ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=duckduckgo
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=1
WEB_FETCH_MAX_CONTENT_LENGTH=5000
DDGS_BACKEND=bing

DEFAULT_MODELS="models/gemini-3.5-flash"

# Generate a unique, stable secret for each deployment: openssl rand -hex 32
# Set the generated value in your private .env or deployment secrets; never commit it.
WEBUI_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
